# Keep images, reports, and other inspectable test outputs under tests/_cache_dir.
# Default is 0: each ordinary test uses an isolated directory under
# tests/_cache_dir/_tmp and cleans it after the test.
QB_TEST_KEEP_ARTIFACTS=0

# External Freddie and housing macro data directories. Set the real paths in
# the gitignored repo .env; project workflows load it, procs read only the
# process environment.
FREDDIE_DATA_ROOT=
MACRO_DATA_ROOT=
